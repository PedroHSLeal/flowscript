{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-vl:4b",
  "enabled_providers": [
    "ollama",
    "openrouter"
  ],
  "permission": {
    "*": "allow"
  },
  "lsp": {},
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "ministral-3:8b": {
          "name": "Ministral 3 (8B)"
        },
        "qwen3-vl:4b": {
          "name": "Qwen 3 (vl-4B)"
        }
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}