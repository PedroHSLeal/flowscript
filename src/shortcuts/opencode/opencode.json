{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ollama",
    "openrouter"
  ],
  "permission": {
    "*": "allow"
  },
  "lsp": {},
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://custom-ollama:11434/v1"
      },
      "models": {
        "ministral-3:8b": { "name": "Ministral 3 (8B)" },
        "ministral-3:3b": { "name": "Ministral 3 (3B)" },
        "qwen3-vl:4b": { "name": "Qwen 3 (vl-4B)" },
        "qwen3.5:4b": { "name": "Qwen 3.5 (4B)" },
        "granite4:350m": { "name": "Granite 4 (350M)" },
        "lfm2.5-thinking:latest": { "name": "LFM 2.5" },
      }
    },
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}